# Modify a colon (:) separated variable.  The operation is specified by the
# first argument, $1.  The name of the variable is specified in $2.
# The additions/modifications are given in arguments 3 and 4, as
# necessary.  The supported operations are append, prepend, remove, replace.
modpath () {
    # safer modpath that doesn't rely on word-splitting and therefore
    # correctly handles path elements containing spaces or special
    # characters such as parentheses. Arguments:
    #   $1 = operation: prepend|append|remove|replace
    #   $2 = name of the variable to operate on
    #   $3 = element to add/remove/replace
    #   $4 = replacement value (for replace)
    local op name value result add repl
    op="$1"; name="$2"; add="$3"; repl="$4"

    # read the current value of the named variable (may be empty)
    eval "value=\"\${${name}-}\""

    # iterator: print each element (split only on ':') without word-splitting
    _iter_parts() {
        local s="$1"
        while [ -n "$s" ]; do
            local part
            if [[ "$s" == *:* ]]; then
                part="${s%%:*}"
                s="${s#*:}"
            else
                part="$s"
                s=""
            fi
            printf '%s\n' "$part"
        done
    }

    case "$op" in
        prepend)
            result="$value"
            if [ -z "$value" ]; then
                result="$add"
            else
                present=false
                while IFS= read -r part; do
                    if [ "$part" = "$add" ]; then
                        present=true
                        break
                    fi
                done < <(_iter_parts "$value")
                if ! $present; then
                    result="$add:$value"
                fi
            fi
            ;;
        append)
            result="$value"
            if [ -z "$value" ]; then
                result="$add"
            else
                present=false
                while IFS= read -r part; do
                    if [ "$part" = "$add" ]; then
                        present=true
                        break
                    fi
                done < <(_iter_parts "$value")
                if ! $present; then
                    result="$value:$add"
                fi
            fi
            ;;
        remove)
            result=""
            while IFS= read -r part; do
                if [ "$part" != "$add" ]; then
                    if [ -z "$result" ]; then
                        result="$part"
                    else
                        result="$result:$part"
                    fi
                fi
            done < <(_iter_parts "$value")
            ;;
        replace)
            result=""
            while IFS= read -r part; do
                if [ "$part" != "$add" ]; then
                    if [ -z "$result" ]; then
                        result="$part"
                    else
                        result="$result:$part"
                    fi
                else
                    if [ -z "$result" ]; then
                        result="$repl"
                    else
                        result="$result:$repl"
                    fi
                fi
            done < <(_iter_parts "$value")
            ;;
        *)
            return 1
            ;;
    esac

    # assign back to named variable safely (no eval that suffers word-splitting)
    printf -v "$name" '%s' "$result"
}

# convenience routine which appends a string to a path.
append () {
    modpath append "$1" "$2"
}

# convenience routine which prepends a string to a path.
prepend () {
    modpath prepend "$1" "$2" 
}
# convenience routine which prepends a string to a path.
remove () {
    modpath remove "$1" "$2" 
}
# convenience routine which prepends a string to a path.
replace () {
    modpath replace "$1" "$2" "$3"
}

# Set ignoreeof if you don't want EOF as the sole input to the shell to
# immediately signal a quit condition.  This only happens at the start
# of a line if the line is empty, and you haven't just deleted a character
# with C-d.  I set this to 2 so that it requires 3 successive ^D's to exit
ignoreeof=2

# Set auto_resume if you want TWENEX style behavior for command names.
auto_resume=

# Set notify if you want to be asynchronously notified about background
# job completion.
notify=
set -o notify

# make it so I can use variable names as arguments to cd and pushd
shopt -s cdable_vars

# Make it so that failed `exec' commands don't flush this shell.
no_exit_on_failed_exec=

# The use of SHLVL allows one to see what level of recursive shell is 
# executing.  Bash automagically increments SHLVL if it is in the environment
# when it starts
#  PS1="(${SHLVL})\h\\$ "
#  PS1='\033]0;\h:\w\007\h:\W\\$ '
PS1='\[\e]0;\h:\w\007\]\h\\$ '
PS2="?> "

# Append lines to history file, not overwrite
shopt -s histappend

export HISTSIZE=256
export HISTFILESIZE=2048
export HISTCONTROL=ignoreboth
export HISTTIMEFORMAT='%F %T '
export HISTFILESIZE=10000
export HISTSIZE=10000

# set this if you want the shell to notify you when you have new mail
unset MAILCHECK

# put multi-line commands in separate history lines
shopt -u lithist 
shopt -u cmdhist

# if hashed commands don't exist, search path
shopt -s checkhash

# check the window size after each command and adjust env vars
shopt -s checkwinsize

# make less more friendly for non-text input files, see lesspipe(1)
