{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "high"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(npm *)",
      "Bash(npx *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  },
    "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "bash /Users/davide/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "repo-maintainers@eg-skills": true,
    "devflow@eg-skills": true,
    "ci-cd@eg-skills": true,
    "git-workflows@eg-skills": true
 },
  "theme": "dark-daltonized"
}
