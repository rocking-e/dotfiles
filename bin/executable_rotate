#! /bin/bash

if [ -z "$1" ]; then
    echo "usage: `basename $0` file"
    exit
fi

file=$1

if [ ! -e $file ]; then
    echo "Silly!  The file '$file' must exist."
    exit
fi

for i in {30..1}; do
    if [ -e $file.$i ]; then
        mv $file.$i $file.`expr $i + 1`
    fi
done
mv $file $file.1

exit
