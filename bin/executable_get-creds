#!/usr/bin/env python3
# pylint: disable=invalid-name
"""
    Ensure AWS credentials are valid for a specified profile. The profile
    can be given by the AWS_PROFILE environment variable or by the
    '-p|--profile' option.

    This tool uses saml2aws to update AWS
    credentials in ~/.aws/credentials for the given
    profile. 
    
    The attribute that specifies the expiration time of the profile
    ('x_security_token_expires' for saml2aws)
    is examined to determine if the credentials have
    expired. If so, saml2aws will be launched with
    the appropriate parameters to re-authenticate and update the
    credentials.

    For this to work properly, a valid configuration must be present in ~/.saml2aws.
    The accounts/profiles must be setup with the proper names.
"""
from argparse import ArgumentParser, RawDescriptionHelpFormatter
from configparser import ConfigParser
import sys
import os
from datetime import datetime, timezone
from dateutil.parser import parse
from logging import *

tools = ["saml2aws", "aws_key_gen", "okta-aws-cli"]

def main():
    # Setup arg parse and parse the command line.
    parser = ArgumentParser(description=__doc__,
                            formatter_class=RawDescriptionHelpFormatter)
    parser.add_argument('-v', '--verbose', action="store_true",
                        help="Enable basic verbose output")
    parser.add_argument('-d', '--debug', action="store_true",
                        help="Turn on very verbose debug output")
    parser.add_argument('-t', '--tool', action="store",
                        choices=tools, default=os.getenv("GET_CREDS_TOOL", "saml2aws"),
                        help="Specify the tool to use to get credentials")
    parser.add_argument('-f', '--force', action="store_true",
                        help="Refresh credentials even if they have not expired.")
    parser.add_argument('-p', '--profile', action="store",
                        default=os.getenv('AWS_PROFILE'),
                        help="Use specified AWS profile instead of environment variable")
    parser.add_argument('--disable-sessions', action='store_true',
                        help="Add the flag to disable sessions")
    parser.add_argument('-n', '--dry-run', action='store_true',
                        help="Show the command that would be executed, but don't actually execute it.")
    args = parser.parse_args()

    # Set the log level, default is WARNING, meaning mostly quiet
    log_level = WARNING
    if args.verbose or os.getenv('VERBOSE'):
        log_level = INFO
    if args.debug or os.getenv('DEBUG'):
        log_level = DEBUG
    basicConfig(format='%(message)s', level=log_level)

    home_dir = os.getenv('HOME')
    cred_file = home_dir + '/.aws/credentials'
    
    aws_profile = args.profile
    if not aws_profile:
        error("Can not find AWS_PROFILE environment variable and one was not specified on the command line.")
        sys.exit(2)

    config = ConfigParser()
    config.read(cred_file)

    # Set local timezone, we might need it later
    LOCAL_TIMEZONE = datetime.now(timezone.utc).astimezone().tzinfo

    if args.tool == "saml2aws":
        skip_prompt=True
        TIME_FMT = '%Y-%m-%dT%H:%M:%S%z'
        FALL_BACK_TIME = '2000-01-01T00:00:00-05:00'
        cmd = f'saml2aws login -a {aws_profile}'
        # DO_PROMPT is set when running via container
        # Can't skip prompt in container because no keychain
        # Also can't skip prompt on Linux system because no keychain
        if os.uname().sysname == "Linux":
            os.environ["DO_PROMPT"] = "YES"
        if os.getenv('DO_PROMPT', None) is None:
            cmd += ' --skip-prompt'
        EXPIRE_LABEL = 'x_security_token_expires'
        if args.disable_sessions:
            cmd += ' --disable-sessions'
    elif args.tool == "okta-aws-cli":
        TIME_FMT = '%Y-%m-%dT%H:%M:%S%z'
        FALL_BACK_TIME = '2000-01-01T00:00:00-05:00'
        cmd = f'okta-aws-cli --profile {aws_profile}'
        EXPIRE_LABEL = 'x_security_token_expires'
    else:
        TIME_FMT = '%Y-%m-%dT%H:%M:%SZ'
        FALL_BACK_TIME = '2000-01-01T00:00:00Z'
        cmd = f'aws_key_gen -p {aws_profile} login'
        EXPIRE_LABEL = 'akg_expiration_time'

    if args.force:
        cmd += ' --force'

    if config.has_section(aws_profile):
        expire_time_str = config.get(aws_profile, EXPIRE_LABEL,
                                    fallback=FALL_BACK_TIME)
        if (expire_time_str == FALL_BACK_TIME) and args.tool == "saml2aws":
            cmd = cmd.replace(' --skip-prompt', '')
        debug(f'expire_time_str = {expire_time_str}')
        debug(f'TIME_FMT = {TIME_FMT}')
        expire_time = parse(expire_time_str)
        now = datetime.now().astimezone()
        if now > expire_time or args.force:
            info(f'credentials for {aws_profile} have expired')
            debug(f'cmd = {cmd}')
            if args.dry_run:
                print(cmd)
            else:
                os.system(cmd)
        else:
            # Creds still valid, show how much time left
            time_left = expire_time - now
            minutes, seconds = divmod(int(time_left.total_seconds()), 60)
            debug(f'expire_time = {expire_time}')
            debug(f'now = {now}')
            debug(f'time_left = {time_left}')
            info(f'Credentials still valid for {minutes} minutes and {seconds} seconds')
            info(f'Refresh credentials with: {cmd} --force')
    else:
        warning(f'no section for {aws_profile}, doing initial login')
        cmd = cmd.replace(' --skip-prompt', '')
        if args.dry_run:
            print(cmd)
        else:
            os.system(cmd)

if __name__ == "__main__":
    main()
